rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isSuperAdmin() {
      return hasRole('superadmin');
    }

    function isManager(tenantId) {
      return isSignedIn()
        && request.auth.token.role == 'manager'
        && request.auth.token.tenantId == tenantId;
    }

    function isOperator(tenantId) {
      return isSignedIn()
        && request.auth.token.role == 'operator'
        && request.auth.token.tenantId == tenantId;
    }

    function isStaff(tenantId) {
      return isSuperAdmin() || isManager(tenantId) || isOperator(tenantId);
    }

    // 'all' é um valor de FILTRO da UI, nunca um valor persistível (W1-7).
    function hasValidCemeteryId() {
      return !('cemeteryId' in request.resource.data)
             || request.resource.data.cemeteryId != 'all';
    }

    // Validação mínima de schema (W2-5) nas coleções mais consumidas por agregadores.
    function validPlotSchema() {
      return request.resource.data.status in ['available', 'occupied', 'reserved', 'blocked']
        && request.resource.data.tenantId is string
        && request.resource.data.cemeteryId is string
        && request.resource.data.cemeteryId != 'all';
    }

    function validFinancialSchema() {
      return request.resource.data.value is number
        && request.resource.data.value >= 0
        && request.resource.data.category in ['income', 'expense']
        && request.resource.data.cemeteryId != 'all';
    }

    // Tenants
    match /tenants/{tenantId} {
      // Nome e endereço do cemitério podem ser públicos, mas dados internos não.
      // Restringir write ao superadmin e read a usuários autenticados do tenant.
      allow read: if isSignedIn()
                  && (isSuperAdmin()
                      || request.auth.token.tenantId == tenantId
                      || request.auth.token.role == 'citizen'); // cidadão pode ler info básica
      allow write: if isSuperAdmin();
    }

    // Cemeteries
    match /cemeteries/{cemeteryId} {
      allow read: if true;
      allow create: if isStaff(request.resource.data.tenantId);
      allow update, delete: if isStaff(resource.data.tenantId);
    }

    // Sectors
    match /sectors/{sectorId} {
      allow read: if true;
      allow create: if isStaff(request.resource.data.tenantId);
      allow update, delete: if isStaff(resource.data.tenantId);
    }

    // Plots
    match /plots/{plotId} {
      // Dados básicos (código, status, setor) podem ser públicos para o mapa.
      // Dados de concessão (concessionHolder, holderDocument) apenas para staff.
      // Como o Firestore não suporta projeção por campo nas regras,
      // a solução correta é separar em duas coleções ou restringir tudo.
      allow read: if isSignedIn()
                  && (isStaff(resource.data.tenantId)
                      || resource.data.status == 'available'); // mapa público só mostra disponíveis
      allow create: if isStaff(request.resource.data.tenantId) && validPlotSchema();
      allow update: if isStaff(resource.data.tenantId) && validPlotSchema();
      allow delete: if isStaff(resource.data.tenantId);
    }

    // Plot concessions (ownership history)
    match /plot_concessions/{concessionId} {
      allow read: if isStaff(resource.data.tenantId);
      allow create: if isStaff(request.resource.data.tenantId);
      allow update, delete: if isStaff(resource.data.tenantId);
    }

    // Official deceased records — staff-only. A busca pública usa a projeção
    // public_deceaseds. Acesso da família ao registro completo será modelado
    // quando o conceito de "gestor familiar do memorial" existir de fato.
    match /deceaseds/{deceasedId} {
      allow read: if isStaff(resource.data.tenantId);
      allow create: if isStaff(request.resource.data.tenantId);
      allow update, delete: if isStaff(resource.data.tenantId);
    }

    // Public projection of deceased records — usada pela busca pública.
    // Contém APENAS campos não-sensíveis (nome, datas, cidade, foto).
    // NUNCA gravar causeOfDeath, familyMembers, documents ou outros dados sensíveis aqui.
    match /public_deceaseds/{deceasedId} {
      allow read: if true; // busca pública
      allow create, update: if isStaff(request.resource.data.tenantId);
      allow delete: if isStaff(resource.data.tenantId);
    }

    // Death notifications used by user garden + admin allocation flow
    match /death_notifications/{notificationId} {
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.status == 'submitted'
                    && !('allocation' in request.resource.data)
                    && !('rejectionReason' in request.resource.data)
                    // tenantId deve ser o dono do cemitério escolhido (anti-poluição cross-tenant)
                    && request.resource.data.cemeteryId is string
                    && request.resource.data.tenantId ==
                       get(/databases/$(database)/documents/cemeteries/$(request.resource.data.cemeteryId)).data.tenantId;

      allow read: if isSignedIn()
                  && (
                    resource.data.createdBy == request.auth.uid
                    || isStaff(resource.data.tenantId)
                  );

      // Cidadão só pode atualizar campos de dados do falecido enquanto status == 'submitted'
      // Staff pode atualizar qualquer campo (alocação, rejeição, status)
      allow update: if isStaff(resource.data.tenantId)
                    || (
                      isSignedIn()
                      && resource.data.createdBy == request.auth.uid
                      && resource.data.status == 'submitted'
                      // Impede cidadão de alterar campos sensíveis de controle
                      && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['status', 'allocation', 'rejectionReason', 'tenantId', 'createdBy'])
                    );

      allow delete: if isSignedIn()
                    && (
                      (
                        resource.data.createdBy == request.auth.uid
                        && resource.data.status == 'rejected'
                      )
                      || isStaff(resource.data.tenantId)
                    );
    }

    // Memorials
    match /memorials/{memorialId} {
      allow read: if resource.data.privacyLevel == 'public'
                  || resource.data.privacyLevel == 'link_only'
                  || (
                    isSignedIn()
                    && resource.data.privacyLevel == 'private'
                    && request.auth.uid in resource.data.managers
                  );

      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid in resource.data.managers;
      allow delete: if isSuperAdmin();

      // Tributes
      match /tributes/{tributeId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update: if isSignedIn()
                      && (
                        request.auth.uid == resource.data.authorUid
                        || request.auth.uid in get(/databases/$(database)/documents/memorials/$(memorialId)).data.managers
                      );
      }
    }

    // Audit logs (immutable)
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin() || isManager(resource.data.tenantId);
      allow create: if isSignedIn()
                    && isStaff(request.resource.data.tenantId)
                    && request.resource.data.actorUid == request.auth.uid
                    && !('oldValue' in request.resource.data
                         ? request.resource.data.oldValue.keys().hasAny(['causeOfDeath', 'holderDocument'])
                         : false); // não permitir logs com campos sensíveis — use Cloud Function para logs completos
      allow update, delete: if false;
    }

    // Service requests
    match /requests/{requestId} {
      allow create: if isSignedIn();
      allow read: if request.auth.uid == resource.data.requesterUid
                  || isStaff(resource.data.tenantId);
      allow update: if isStaff(resource.data.tenantId)
                    || (
                      request.auth.uid == resource.data.requesterUid
                      && resource.data.status == 'open'
                    );
    }

    // User profile for citizen area.
    // get (doc único): dono, superadmin, ou staff — o staff precisa do contato de quem
    //   comunicou um óbito ao seu tenant (LGPD art. 7º III — execução de serviço público).
    // list (varredura): APENAS dono/superadmin — staff não pode enumerar cidadãos.
    match /user_profiles/{uid} {
      allow get: if isSignedIn()
                 && (request.auth.uid == uid
                     || isSuperAdmin()
                     || request.auth.token.role in ['manager', 'operator']);
      allow list: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSuperAdmin();
    }

    // Manager profiles (created by Cloud Functions via Admin SDK).
    // Manager lê os perfis do PRÓPRIO tenant (necessário para atribuir
    // administrador responsável a um cemitério e, futuramente, gerir equipe).
    match /profiles/{userId} {
      allow read: if isSuperAdmin()
                  || request.auth.uid == userId
                  || isManager(resource.data.tenantId);
      allow write: if isSuperAdmin();
    }

    // SCI - Operational management
    match /sci_operational_records/{recordId} {
      allow read: if isSignedIn() && isStaff(resource.data.tenantId);
      allow create: if isSignedIn() && isStaff(request.resource.data.tenantId) && hasValidCemeteryId();
      allow update: if isSignedIn() && isStaff(resource.data.tenantId) && hasValidCemeteryId();
      allow delete: if isSignedIn() && isStaff(resource.data.tenantId);
    }

    // SCI - Occurrences
    match /sci_occurrences/{occurrenceId} {
      allow read: if isSignedIn() && isStaff(resource.data.tenantId);
      allow create: if isSignedIn() && isStaff(request.resource.data.tenantId) && hasValidCemeteryId();
      allow update: if isSignedIn() && isStaff(resource.data.tenantId) && hasValidCemeteryId();
      allow delete: if isSignedIn() && isStaff(resource.data.tenantId);
    }

    // SCI - Internal notifications
    match /sci_internal_notifications/{notificationId} {
      allow read: if isSignedIn() && isStaff(resource.data.tenantId);
      allow create: if isSignedIn() && isStaff(request.resource.data.tenantId) && hasValidCemeteryId();
      allow update: if isSignedIn() && isStaff(resource.data.tenantId) && hasValidCemeteryId();
      allow delete: if isSignedIn() && isStaff(resource.data.tenantId);
    }

    // SCI - Sanitary checks
    match /sci_sanitary_checks/{checkId} {
      allow read: if isSignedIn() && isStaff(resource.data.tenantId);
      allow create: if isSignedIn() && isStaff(request.resource.data.tenantId) && hasValidCemeteryId();
      allow update: if isSignedIn() && isStaff(resource.data.tenantId) && hasValidCemeteryId();
      allow delete: if isSignedIn() && isStaff(resource.data.tenantId);
    }

    // SCI - Environmental checks
    match /sci_environmental_checks/{checkId} {
      allow read: if isSignedIn() && isStaff(resource.data.tenantId);
      allow create: if isSignedIn() && isStaff(request.resource.data.tenantId) && hasValidCemeteryId();
      allow update: if isSignedIn() && isStaff(resource.data.tenantId) && hasValidCemeteryId();
      allow delete: if isSignedIn() && isStaff(resource.data.tenantId);
    }

    // SCI - Financial records
    match /sci_financial_records/{recordId} {
      allow read: if isSignedIn() && isStaff(resource.data.tenantId);
      allow create: if isSignedIn() && isStaff(request.resource.data.tenantId) && validFinancialSchema();
      allow update: if isSignedIn() && isStaff(resource.data.tenantId) && validFinancialSchema();
      allow delete: if isSignedIn() && isStaff(resource.data.tenantId);
    }

    // SCI - Stock items
    match /sci_stock_items/{itemId} {
      allow read: if isSignedIn() && isStaff(resource.data.tenantId);
      allow create: if isSignedIn() && isStaff(request.resource.data.tenantId) && hasValidCemeteryId();
      allow update: if isSignedIn() && isStaff(resource.data.tenantId) && hasValidCemeteryId();
      allow delete: if isSignedIn() && isStaff(resource.data.tenantId);
    }

    // SCI - Documents
    match /sci_documents/{documentId} {
      allow read: if isSignedIn() && isStaff(resource.data.tenantId);
      allow create: if isSignedIn() && isStaff(request.resource.data.tenantId) && hasValidCemeteryId();
      allow update: if isSignedIn() && isStaff(resource.data.tenantId) && hasValidCemeteryId();
      allow delete: if isSignedIn() && isStaff(resource.data.tenantId);
    }

    // SCI - AI agents and chatbots
    match /sci_ai_agents/{agentId} {
      allow read: if isSignedIn() && isStaff(resource.data.tenantId);
      allow create: if isSignedIn() && isStaff(request.resource.data.tenantId) && hasValidCemeteryId();
      allow update: if isSignedIn() && isStaff(resource.data.tenantId) && hasValidCemeteryId();
      allow delete: if isSignedIn() && isStaff(resource.data.tenantId);
    }

    // SCI - Generated reports
    match /sci_reports/{reportId} {
      allow read: if isSignedIn() && isStaff(resource.data.tenantId);
      allow create: if isSignedIn() && isStaff(request.resource.data.tenantId) && hasValidCemeteryId();
      allow update: if isSignedIn() && isStaff(resource.data.tenantId) && hasValidCemeteryId();
      allow delete: if isSignedIn() && isStaff(resource.data.tenantId);
    }

    // SCI - Support tickets
    match /sci_support_tickets/{ticketId} {
      allow read: if isSignedIn() && isStaff(resource.data.tenantId);
      allow create: if isSignedIn() && isStaff(request.resource.data.tenantId) && hasValidCemeteryId();
      allow update: if isSignedIn() && isStaff(resource.data.tenantId) && hasValidCemeteryId();
      allow delete: if isSignedIn() && isStaff(resource.data.tenantId);
    }

    // SCI - Training sessions
    match /sci_training_sessions/{sessionId} {
      allow read: if isSignedIn() && isStaff(resource.data.tenantId);
      allow create: if isSignedIn() && isStaff(request.resource.data.tenantId) && hasValidCemeteryId();
      allow update: if isSignedIn() && isStaff(resource.data.tenantId) && hasValidCemeteryId();
      allow delete: if isSignedIn() && isStaff(resource.data.tenantId);
    }

    // SCI - Partners (parceiros credenciados) — W4-3
    match /sci_partners/{partnerId} {
      allow read: if isSignedIn() && isStaff(resource.data.tenantId);
      allow create: if isSignedIn() && isStaff(request.resource.data.tenantId) && hasValidCemeteryId();
      allow update: if isSignedIn() && isStaff(resource.data.tenantId) && hasValidCemeteryId();
      allow delete: if isSignedIn() && isStaff(resource.data.tenantId);
    }

    // SCI - Stock movements (movimentações de estoque) — W4-8. Imutáveis (trilha).
    match /sci_stock_movements/{movementId} {
      allow read: if isSignedIn() && isStaff(resource.data.tenantId);
      allow create: if isSignedIn() && isStaff(request.resource.data.tenantId);
      allow update, delete: if false;
    }

    // ─── Monitoring Agent Collections ─────────────────────────────────────────
    // Leitura: apenas SuperAdmins
    // Escrita: apenas Cloud Functions (Admin SDK) — bloqueada para clientes

    match /monitor_metrics/{doc} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /monitor_history/{doc} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /monitor_alerts/{doc} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /monitor_function_errors/{doc} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /_monitor/{doc} {
      allow read, write: if false;
    }

    // Contadores de uso de IA por uid/dia — apenas Admin SDK (W2-8)
    match /ai_usage/{docId} {
      allow read, write: if false;
    }
  }
}
